+// Wayland preedit positions are UTF-8 bytes; GPUI marked-text selections
+// use UTF-16 code units relative to the marked text. Reject invalid offsets.
+fn preedit_selection_utf16(
+    text: &str,
+    cursor_begin: i32,
+    cursor_end: i32,
+) -> Option<std::ops::Range<usize>> {
+    let begin = usize::try_from(cursor_begin).ok()?;
+    let end = usize::try_from(cursor_end).ok()?;
+    let begin = text.get(..begin)?.encode_utf16().count();
+    let end = text.get(..end)?.encode_utf16().count();
+    Some(begin.min(end)..begin.max(end))
+}

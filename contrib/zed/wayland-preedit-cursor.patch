     use super::*;
 
     #[test]
+    fn preedit_cursor_uses_utf16_marked_text_offsets() {
+        assert_eq!(preedit_selection_utf16("你好", 0, 0), Some(0..0));
+        assert_eq!(preedit_selection_utf16("你好", 3, 3), Some(1..1));

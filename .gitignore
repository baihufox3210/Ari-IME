build/
build-*/
pkg/
*.pkg.tar.*
*.gcov
__pycache__/

# makepkg uses $startdir/src as its build directory, which collides with this
# project's real source directory. Ignore what it drops there so a stray run
# cannot be committed. (scripts/build-from-source.sh --package builds from a
# copy instead, so it never touches src/.)
/src/Ari-IME-*/
/src/build/
/src/*.tar.gz
/*.tar.gz

# dpkg-buildpackage artifacts
obj-*/
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/fcitx5-ari-ime/
debian/*.substvars
debian/*.log
*.deb
*.buildinfo
*.changes

# Most maintainer-only tests stay private. Publish the buffer regression and
# portable dictionary converter tests that protect user-facing behavior.
/test/*
!/test/test_buffer.cpp
!/test/test_common.h
!/test/test_convert_vchewing_dictionary.py
/wasm/test/
result
result-*
